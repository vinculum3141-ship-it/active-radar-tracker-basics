    rotation: 0
    state: enabled
- name: doppler_phase
  id: epy_block
  parameters:
    _source_code: |-
      """Doppler phase ramp across pulses.

      LEARNER TASK (05-roadmap.md stage 7): implement work().

      Applies a constant per-pulse phase advance to the delayed echo,
      modelling the target's radial velocity. The phase advances once per
      pulse: phase_increment_rad = 2*pi*f_d*PRI with f_d = 2*v/lambda.
      See docs/training/01-physics.md section 4. The leakage path (direct
      TX-to-RX) is NOT rotated, so it stays at zero Doppler.
      """

      import numpy as np
      from gnuradio import gr


      class blk(gr.sync_block):
          """Apply a slow-time phase ramp (once per samples_per_pulse samples)."""

          def __init__(self, samples_per_pulse=20000,
                       phase_increment_rad=4.1050144006906635):
              gr.sync_block.__init__(
                  self,
                  name='Doppler Phase Ramp',
                  in_sig=[np.complex64],
                  out_sig=[np.complex64],
              )
              self.samples_per_pulse = int(samples_per_pulse)
              self.increment = float(phase_increment_rad)
              self.idx_in_pulse = 0
              self.phase = 0.0

          def work(self, input_items, output_items):
              """Rotate every input sample by the current pulse's phase.

              Learner task (05-roadmap.md stage 7 / 03-hardware.md 2.3):
              apply exp(j*phase) per sample, advancing phase by
              phase_increment_rad once per samples_per_pulse samples.
              Return the number of samples written.
              """
              raise NotImplementedError(
                  'Implement work() (05-roadmap.md stage 7)')
    samples_per_pulse: '20000'
    phase_increment_rad: '4.1050144006906635'
    affinity: ''
    alias: ''
    comment: 'Per-pulse Doppler phase (moving target, v=40 m/s)'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 700]
    rotation: 0
    state: enabled
