- name: range_doppler
  id: epy_block
  parameters:
    _source_code: |-
      """Range-Doppler map: slow-time FFT over the buffered pulse matrix.

      LEARNER TASK (05-roadmap.md stage 7): implement work().

      Input is the matched-filter stream for one fast-time window per pulse
      (blocks_keep_m_in_n makes the pulses back-to-back). Every
      n_pulses*PULSE samples the block reshapes into a [pulse x range]
      matrix, FFTs along slow time (pulse axis), shifts the Doppler axis and
      emits the magnitude map row by row (doppler x range) for the raster
      sink. Mirrors doppler.range_doppler_map in the Python sim.
      """

      import numpy as np
      from gnuradio import gr


      class blk(gr.sync_block):
          """2-D range-Doppler map from the matched-filter stream.

          Must be a gr.sync_block (a gateway class) for GRC to use it as an
          epy_block; gr.block is not accepted.
          """

          def __init__(self, n_pulses=64, samples_per_pulse=600):
              gr.sync_block.__init__(
                  self,
                  name='Range-Doppler Map',
                  in_sig=[np.complex64],
                  out_sig=[np.float32],
              )
              self.n_pulses = int(n_pulses)
              self.samples_per_pulse = int(samples_per_pulse)
              self.frame = self.n_pulses * self.samples_per_pulse
              self.norm = float(self.frame)
              self.buffer = np.zeros(0, dtype=np.complex64)
              self.pending = np.zeros(0, dtype=np.float32)

          def work(self, input_items, output_items):
              """Buffer, FFT over slow time per frame, emit magnitude rows.

              Learner task (05-roadmap.md stage 7 / 03-hardware.md 2.3):
              append the input to self.buffer; while len(buffer) >= frame,
              reshape into [pulses x ranges], FFT along the pulse axis,
              fftshift the Doppler axis, take |.|, normalise by self.norm
              and emit rows (doppler x range) for the raster sink.
              Return the number of samples written. The __init__ above
              already sets up in/out sigs, the frame size and buffers.
              """
              raise NotImplementedError(
                  'Implement work() (05-roadmap.md stage 7)')
    n_pulses: '64'
    samples_per_pulse: '600'
    affinity: ''
    alias: ''
    comment: '2-D range-Doppler map (doppler.range_doppler_map)'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1640, 760]
    rotation: 0
    state: enabled
