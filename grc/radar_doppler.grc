options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Range-Doppler map: slow-time FFT across pulses. Matches 03-hardware.md 2.3.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: radar_doppler
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Radar Range-Doppler Map
    window_size: 1280, 720
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [-1, 0]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 'Sampling rate (RadarConfig.fs_hz)'
    value: '20e6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 0]
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    comment: 'Carrier frequency for display - baseband 0'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 40]
    rotation: 0
    state: enabled
- name: fc_rf
  id: variable
  parameters:
    comment: 'RF carrier used for Doppler math (2.45 GHz, ISM band)'
    value: '2.45e9'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 80]
    rotation: 0
    state: enabled
- name: bandwidth_hz
  id: variable
  parameters:
    comment: 'Chirp bandwidth'
    value: '5e6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 120]
    rotation: 0
    state: enabled
- name: pulse_width_s
  id: variable
  parameters:
    comment: 'Pulse width'
    value: '20e-6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 160]
    rotation: 0
    state: enabled
- name: pri_s
  id: variable
  parameters:
    comment: 'Pulse repetition interval'
    value: '1e-3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 200]
    rotation: 0
    state: enabled
- name: n_pulse_samp
  id: variable
  parameters:
    comment: 'Samples per pulse'
    value: int(pulse_width_s*samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 240]
    rotation: 0
    state: enabled
- name: n_pri_samp
  id: variable
  parameters:
    comment: 'Samples per PRI'
    value: int(pri_s*samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 280]
    rotation: 0
    state: enabled
- name: c
  id: variable
  parameters:
    comment: 'Speed of light (m/s)'
    value: '3e8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 320]
    rotation: 0
    state: enabled
- name: range_m
  id: variable
  parameters:
    comment: 'Target range (m) - the R=1000 m test case'
    value: '1000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 360]
    rotation: 0
    state: enabled
- name: n_delay
  id: variable
  parameters:
    comment: 'Round-trip delay in samples: round(2R/c * fs) = 133'
    value: int(round(2*range_m/c*samp_rate))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 400]
    rotation: 0
    state: enabled
- name: noise_amp
  id: variable
  parameters:
    comment: 'Noise amplitude (~20 dB SNR)'
    value: '0.05'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 440]
    rotation: 0
    state: enabled
- name: n_pulses
  id: variable
  parameters:
    comment: 'Pulses per coherent processing interval (RadarConfig.n_pulses)'
    value: '64'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 480]
    rotation: 0
    state: enabled
- name: n_win
  id: variable
  parameters:
    comment: 'Fast-time listen window per pulse (pulse + echo guard)'
    value: int(1.5*pulse_width_s*samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 520]
    rotation: 0
    state: enabled
- name: target_velocity_mps
  id: variable
  parameters:
    comment: 'Target radial velocity (m/s) - the v=40 m/s test case'
    value: '40'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 560]
    rotation: 0
    state: enabled
- name: doppler_phase_incr
  id: variable
  parameters:
    comment: 'Per-pulse phase advance = 2*pi*f_d*PRI, f_d = 2v/lambda'
    value: 2*3.141592653589793*2*target_velocity_mps*fc_rf/c*pri_s
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 600]
    rotation: 0
    state: enabled
- name: radar_taps
  id: epy_module
  parameters:
    source_code: |-
      """Radar waveform helpers for the GNU Radio flowgraphs.

      LEARNER TASK (05-roadmap.md stage 2 / 03-hardware.md 2.1-2.2):
      implement chirp(), pulse_vector() and matched() below so the
      flowgraphs can be generated and run. These mirror
      src/radar/signal_gen.py. All functions must return numpy complex128
      arrays; GRC converts them to gr_complex. See
      docs/training/01-physics.md section 2 (LFM) for the math.
      """

      import numpy as np


      def chirp(samp_rate=20e6, pulse_width_s=20e-6, bandwidth_hz=5e6, fc_hz=0.0):
          """Complex analytic LFM chirp, one pulse of fast-time samples.

          slope = bandwidth_hz / pulse_width_s
          return np.exp(1j * 2 * np.pi * (fc_hz * t + 0.5 * slope * t**2))
          with t = arange(int(pulse_width_s*samp_rate)) / samp_rate.
          """
          raise NotImplementedError(
              'Implement chirp() (05-roadmap.md stage 2)')


      def pulse_vector(samp_rate=20e6, pulse_width_s=20e-6, pri_s=1e-3,
                       bandwidth_hz=5e6, fc_hz=0.0):
          """One PRI: LFM chirp followed by the quiet window (zeros).

          np.concatenate([chirp(...), np.zeros(n_pri - n_pulse)]).
          """
          raise NotImplementedError(
              'Implement pulse_vector() (05-roadmap.md stage 2)')


      def matched(samp_rate=20e6, pulse_width_s=20e-6, bandwidth_hz=5e6):
          """Matched-filter taps: conjugated, time-reversed chirp.

          np.conj(chirp(...)[::-1]). Convolving with the echo gives the
          compressed pulse (range resolution c/(2B)).
          """
          raise NotImplementedError(
              'Implement matched() (05-roadmap.md stage 4)')
    affinity: ''
    alias: ''
    comment: 'Radar waveform helpers (pulse_vector, matched)'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 40]
    rotation: 0
    state: enabled
- name: blocks_vector_source_x_0
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: 'TX waveform copy = pulsed LFM chirp'
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: complex
    vector: radar_taps.pulse_vector()
    vlen: '1'
