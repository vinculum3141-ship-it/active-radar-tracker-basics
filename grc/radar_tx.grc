options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Transmit waveform: pulsed LFM chirp. Matches 03-hardware.md 2.1.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: radar_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Radar Transmitter (pulsed LFM chirp)
    window_size: 1280, 720
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [-1, 0]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 'Sampling rate (04-python-discipline.md RadarConfig.fs_hz)'
    value: '20e6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 0]
    rotation: 0
    state: enabled
- name: fc
  id: variable
  parameters:
    comment: 'Carrier frequency (RadarConfig.fc_hz) - baseband 0 here'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 40]
    rotation: 0
    state: enabled
- name: bandwidth_hz
  id: variable
  parameters:
    comment: 'Chirp bandwidth (RadarConfig.bandwidth_hz)'
    value: '5e6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 80]
    rotation: 0
    state: enabled
- name: pulse_width_s
  id: variable
  parameters:
    comment: 'Pulse width (RadarConfig.pulse_width_s)'
    value: '20e-6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 120]
    rotation: 0
    state: enabled
- name: pri_s
  id: variable
  parameters:
    comment: 'Pulse repetition interval (RadarConfig.pri_s)'
    value: '1e-3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 160]
    rotation: 0
    state: enabled
- name: n_pulse_samp
  id: variable
  parameters:
    comment: 'Samples per pulse'
    value: int(pulse_width_s*samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 200]
    rotation: 0
    state: enabled
- name: n_pri_samp
  id: variable
  parameters:
    comment: 'Samples per PRI (the quiet window between pulses)'
    value: int(pri_s*samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [120, 240]
    rotation: 0
    state: enabled
- name: radar_taps
  id: epy_module
  parameters:
    source_code: |-
      """Radar waveform helpers for the GNU Radio flowgraphs.

      LEARNER TASK (05-roadmap.md stage 2 / 03-hardware.md 2.1-2.2):
      implement chirp(), pulse_vector() and matched() below so the
      flowgraphs can be generated and run. These mirror
      src/radar/signal_gen.py. All functions must return numpy complex128
      arrays; GRC converts them to gr_complex. See
      docs/training/01-physics.md section 2 (LFM) for the math.
      """

      import numpy as np


      def chirp(samp_rate=20e6, pulse_width_s=20e-6, bandwidth_hz=5e6, fc_hz=0.0):
          """Complex analytic LFM chirp, one pulse of fast-time samples.

          slope = bandwidth_hz / pulse_width_s
          return np.exp(1j * 2 * np.pi * (fc_hz * t + 0.5 * slope * t**2))
          with t = arange(int(pulse_width_s*samp_rate)) / samp_rate.
          """
          raise NotImplementedError(
              'Implement chirp() (05-roadmap.md stage 2)')


      def pulse_vector(samp_rate=20e6, pulse_width_s=20e-6, pri_s=1e-3,
                       bandwidth_hz=5e6, fc_hz=0.0):
          """One PRI: LFM chirp followed by the quiet window (zeros).

          np.concatenate([chirp(...), np.zeros(n_pri - n_pulse)]).
          """
          raise NotImplementedError(
              'Implement pulse_vector() (05-roadmap.md stage 2)')


      def matched(samp_rate=20e6, pulse_width_s=20e-6, bandwidth_hz=5e6):
          """Matched-filter taps: conjugated, time-reversed chirp.

          np.conj(chirp(...)[::-1]). Convolving with the echo gives the
          compressed pulse (range resolution c/(2B)).
          """
          raise NotImplementedError(
              'Implement matched() (05-roadmap.md stage 4)')
    affinity: ''
    alias: ''
    comment: 'Radar waveform helpers (pulse_vector, matched)'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 40]
    rotation: 0
    state: enabled
- name: blocks_vector_source_x_0
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: 'Pulsed LFM chirp = transmit waveform (signal_gen.transmit_waveform)'
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: complex
    vector: radar_taps.pulse_vector()
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 320]
    rotation: 0
    state: enabled
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: 'Limit the flowgraph to the real sample rate (no CPU runaway)'
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 320]
    rotation: 0
    state: enabled
- name: qtgui_time_sink_x_0
  id: qtgui_time_sink_x
  parameters:
    type: complex
    name: '"TX pulsed chirp (I) / (Q)"'
    ylabel: Amplitude
    yunit: '""'
    size: '4096'
    srate: samp_rate
    grid: 'False'
    autoscale: 'False'
    ymin: '-1.5'
    ymax: '1.5'
    nconnections: '1'
    update_time: '0.10'
    entags: 'True'
    gui_hint: '1,0,1,1'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_level: '0.0'
    tr_delay: '0'
    tr_chan: '0'
    tr_tag: '""'
    ctrlpanel: 'False'
    legend: 'True'
    axislabels: 'True'
    stemplot: 'False'
    label1: 'TX I'
    width1: 1
    color1: blue
    style1: 1
    marker1: -1
    alpha1: 1.0
    label2: 'TX Q'
    width2: 1
    color2: red
    style2: 1
    marker2: -1
    alpha2: 1.0
    label3: 'Signal 3'
    width3: 1
    color3: green
    style3: 1
    marker3: -1
    alpha3: 1.0
    label4: 'Signal 4'
    width4: 1
    color4: black
    style4: 1
    marker4: -1
    alpha4: 1.0
    label5: 'Signal 5'
    width5: 1
    color5: cyan
    style5: 1
    marker5: -1
    alpha5: 1.0
    label6: 'Signal 6'
    width6: 1
    color6: magenta
    style6: 1
    marker6: -1
    alpha6: 1.0
    label7: 'Signal 7'
    width7: 1
    color7: yellow
    style7: 1
    marker7: -1
    alpha7: 1.0
    label8: 'Signal 8'
    width8: 1
    color8: dark red
    style8: 1
    marker8: -1
    alpha8: 1.0
    label9: 'Signal 9'
    width9: 1
    color9: dark green
    style9: 1
    marker9: -1
    alpha9: 1.0
    label10: 'Signal 10'
    width10: 1
    color10: dark blue
    style10: 1
    marker10: -1
    alpha10: 1.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 280]
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters:
    type: complex
    name: '"TX spectrum"'
    fftsize: '1024'
    freqhalf: 'True'
    wintype: window.WIN_BLACKMAN_hARRIS
    norm_window: 'False'
    fc: fc
    bw: samp_rate
    grid: 'False'
    autoscale: 'False'
    average: '1.0'
    ymin: '-140'
    ymax: '10'
    label: Relative Gain
    units: dB
    nconnections: '1'
    update_time: '0.10'
    showports: 'False'
    gui_hint: '0,0,1,1'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_level: '0.0'
    tr_chan: '0'
    tr_tag: '""'
    ctrlpanel: 'False'
    legend: 'True'
    axislabels: 'True'
    label1: ''
    width1: '1'
    color1: '"blue"'
    alpha1: '1.0'
    label2: "''"
    width2: '1'
    color2: '"red"'
    alpha2: '1.0'
    label3: "''"
    width3: '1'
    color3: '"green"'
    alpha3: '1.0'
    label4: "''"
    width4: '1'
    color4: '"black"'
    alpha4: '1.0'
    label5: "''"
    width5: '1'
    color5: '"cyan"'
    alpha5: '1.0'
    label6: "''"
    width6: '1'
    color6: '"magenta"'
    alpha6: '1.0'
    label7: "''"
    width7: '1'
    color7: '"yellow"'
    alpha7: '1.0'
    label8: "''"
    width8: '1'
    color8: '"dark red"'
    alpha8: '1.0'
    label9: "''"
    width9: '1'
    color9: '"dark green"'
    alpha9: '1.0'
    label10: "''"
    width10: '1'
    color10: '"dark blue"'
    alpha10: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 440]
    rotation: 0
    state: enabled

connections:
- [blocks_vector_source_x_0, '0', blocks_throttle2_0, '0']
- [blocks_throttle2_0, '0', qtgui_time_sink_x_0, '0']
- [blocks_throttle2_0, '0', qtgui_freq_sink_x_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.10.0